<div class="parent-nav" id="navContainer">
    <button type="button" class="navBtn" data-page="Home" data-id="">
        <div class="circle purple"><img src="~/images/chat.png" alt="Chat"></div>
        <span>Communication</span>
    </button>

    <button type="button" class="navBtn" data-page="MyDailyCare" data-id="118">
        <div class="circle teal"><img src="~/images/my_daily_care.png" alt="My Daily Care"></div>
        <span>My Daily Care</span>
    </button>

    <button type="button" class="navBtn" data-page="RoomComfort" data-id="134">
        <div class="circle blue"><img src="~/images/room_comfort.png" alt="Room"></div>
        <span>Room & Comfort</span>
    </button>

    <button type="button" class="navBtn" data-page="FoodDining" data-id="115">
        <div class="circle orange"><img src="~/images/food_dining.png" alt="Food"></div>
        <span>Food & Dining</span>
    </button>

    <button type="button" class="navBtn" data-page="Logisitics" data-id="131">
        <div class="circle violet"><img src="~/images/logistics.png" alt="Logistics"></div>
        <span>Logistics</span>
    </button>

    <button type="button" class="navBtn feedbackBtn" data-page="DischargeFeedback">
        <div class="circle pink">
            <img src="~/images/FeedBackNav.png" alt="Feedback">
        </div>
        <span>Feedback</span>
    </button>
</div>

<style>
    .parent-nav {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 4px;
        width: 100%;
        padding: 8px 6px 7px;
        box-sizing: border-box;
        flex-wrap: nowrap;
        overflow-x: auto;
        overflow-y: hidden;
        scrollbar-width: none;
    }

        .parent-nav::-webkit-scrollbar {
            display: none;
        }

    .navBtn {
        flex: 1 1 0;
        min-width: 56px;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: flex-start;
        gap: 6px;
        padding: 0 2px;
        margin: 0;
        border: 0;
        outline: 0;
        background: transparent;
        cursor: pointer;
        -webkit-tap-highlight-color: transparent;
        text-align: center;
    }

        .navBtn .circle {
            width: clamp(42px, 11vw, 52px);
            height: clamp(42px, 11vw, 52px);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
            margin: 0 auto;
            padding: 0;
            box-sizing: border-box;
            transition: transform 0.15s ease;
        }

            .navBtn .circle img {
                width: 54%;
                height: 54%;
                object-fit: contain;
                display: block;
                margin: 0;
                padding: 0;
            }

        .navBtn span {
            width: 100%;
            min-height: 26px;
            padding: 0;
            margin: 0;
            display: flex;
            align-items: flex-start;
            justify-content: center;
            text-align: center;
            color: #172033;
            font-size: clamp(10px, 2.7vw, 12px);
            font-weight: 500;
            line-height: 1.2;
            white-space: normal;
            overflow-wrap: anywhere;
            box-sizing: border-box;
        }

    .circle.purple {
        background: #7c3aed;
    }

    .circle.teal {
        background: #14b8a6;
    }

    .circle.blue {
        background: #3b82f6;
    }

    .circle.orange {
        background: #ea580c;
    }

    .circle.violet {
        background: #8b5cf6;
    }

    .circle.pink {
        background: #E52B50;
    }

    .feedbackBtn .circle img {
        width: 58%;
        height: 58%;
        object-fit: contain;
        filter: brightness(0) invert(1);
    }

    .navBtn:focus {
        outline: none;
    }

    .navBtn:active .circle {
        transform: scale(0.95);
    }

    @@media (max-width: 380px) {
        .parent-nav {
            justify-content: flex-start;
            gap: 2px;
            padding: 6px 4px;
        }

        .navBtn {
            flex: 0 0 54px;
            min-width: 54px;
        }

            .navBtn .circle {
                width: 40px;
                height: 40px;
            }

            .navBtn span {
                font-size: 9.5px;
            }
    }

    @@media (min-width: 768px) {
        .parent-nav {
            gap: 8px;
            padding: 10px 12px 8px;
        }

        .navBtn .circle {
            width: 52px;
            height: 52px;
        }

        .navBtn span {
            font-size: 12px;
        }
    }
</style>

<script>
    (function () {
        var nav = document.getElementById("navContainer");
        if (!nav) return;

        nav.addEventListener("click", function (e) {
            var btn = e.target.closest(".navBtn");
            if (!btn || !nav.contains(btn)) return;

            var page = btn.getAttribute("data-page");
            if (!page) return;

            var id = btn.getAttribute("data-id");
            if (window.BedContext && typeof window.BedContext.go === "function") {
                window.BedContext.go(page, id ? { id: id } : undefined);
                return;
            }

            var target = new URL("/" + page, window.location.origin);
            if (id) target.searchParams.set("id", id);
            window.location.href = target.toString();
        });
    })();
</script>