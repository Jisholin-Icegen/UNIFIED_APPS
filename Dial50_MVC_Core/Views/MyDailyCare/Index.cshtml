                        }

                            html body #pageContent.content > .card.focused .icon-box img {
                                filter: brightness(0) invert(1) !important;
                            }
    }

    @@media (min-width: 768px) {
        html body #pageContent.content:not(:has(> #interactiveCard)) {
            grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)) !important;
            grid-template-rows: none !important;
            grid-auto-rows: minmax(clamp(200px, 26dvh, 320px), auto) !important;
            align-content: start !important;
            height: auto !important;
            min-height: 0 !important;
            max-height: 100% !important;
            overflow-y: auto !important;
        }

            html body #pageContent.content:not(:has(> #interactiveCard)) > .card {
                height: auto !important;
                min-height: clamp(200px, 26dvh, 320px) !important;
                aspect-ratio: auto !important;
