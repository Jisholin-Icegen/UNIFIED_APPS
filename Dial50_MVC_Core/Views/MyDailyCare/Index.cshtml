@model BedInfo
@{
    ViewData["Title"] = ":: My Daily Care ::";
    var isUnifiedAIFrame = Context.Request.Query["UnifiedAI"] == "1"
        || Context.Request.Query["Unified"] == "1";
}

<link rel="stylesheet" href="~/css/DailyCare.css">
<link rel="stylesheet" href="~/fontawesome/css/all.min.css" />

<link rel="stylesheet" href="~/css/voice-agent/styles.css" asp-append-version="true">

<style>
    html,
    body {
        width: 100% !important;
        min-width: 100% !important;
        margin: 0 !important;
        padding: 0 !important;
        background: #f1f3f7 !important;
        height: 100% !important;
        overflow: hidden !important;
    }

    body {
        display: flex !important;
        flex-direction: column !important;
        justify-content: flex-start !important;
        align-items: stretch !important;
        min-height: 100dvh !important;
        height: 100dvh !important;
        margin: 0 !important;
        padding: 0 !important;
    }

    .app-wrapper {
        position: relative;
        display: flex;
        flex-direction: column;
        width: 100%;
        max-width: 100%;
        min-width: 0;
        height: 100%;
        flex: 1 1 auto;
        margin: 0 auto;
        padding: 0;
        box-sizing: border-box;
        overflow: hidden;
    }

        .app-wrapper > header,
        .app-wrapper > .app-header,
        .app-wrapper > #pageNav,
        .app-wrapper > .assistant-titlebar,
        .app-wrapper > footer {
            flex: 0 0 auto;
            margin-top: 0;
        }

        .app-wrapper > #pageContent,
        .app-wrapper > .content {
            flex: 1 1 auto;
            min-height: 0;
            overflow-y: auto;
            overflow-x: hidden;
            -webkit-overflow-scrolling: touch;
        }

        .app-wrapper > footer {
            width: 100%;
            position: relative;
            z-index: 20;
        }

    @@media (max-width: 480px) {
        body {
            justify-content: stretch !important;
        }

        .app-wrapper {
            max-width: 100%;
            margin-left: 0;
            margin-right: 0;
        }
    }

    #pageContent,
    #pageContent.content {
        display: grid !important;
        grid-template-columns: repeat(2, minmax(0, 1fr)) !important;
        grid-auto-rows: auto !important;
        grid-auto-flow: row !important;
        gap: 14px !important;
        padding: 16px !important;
        box-sizing: border-box !important;
        align-items: stretch !important;
        align-content: start !important;
        overflow-y: auto !important;
        overflow-x: hidden !important;
        flex: 1 1 auto !important;
        min-height: 0 !important;
    }

        #pageContent > * {
            grid-column: auto !important;
            width: 100% !important;
            min-width: 0 !important;
            max-width: 100% !important;
            height: auto !important;
            min-height: 0 !important;
            box-sizing: border-box !important;
        }

        #pageContent .card {
            width: 100% !important;
            height: auto !important;
            min-width: 0 !important;
            min-height: 0 !important;
            aspect-ratio: 1 / 1 !important;
            box-sizing: border-box !important;
            margin: 0 !important;
            padding: 16px 12px !important;
            display: flex !important;
            flex-direction: column !important;
            align-items: center !important;
            justify-content: center !important;
            text-align: center !important;
            border-radius: 18px !important;
            background: #fff !important;
            border: 1px solid #eef1f5 !important;
            box-shadow: 0 4px 10px rgba(0, 0, 0, .04) !important;
            overflow: hidden !important;
        }

            #pageContent .card .icon-box {
                width: 56px !important;
                height: 56px !important;
                min-width: 56px !important;
                min-height: 56px !important;
                flex-shrink: 0 !important;
                margin: 0 auto 12px !important;
                display: flex !important;
                align-items: center !important;
                justify-content: center !important;
                border-radius: 16px !important;
                background: #f3f4f6 !important;
            }

                #pageContent .card .icon-box img {
                    width: 32px !important;
                    height: 32px !important;
                    object-fit: contain !important;
                }

            #pageContent .card h3 {
                width: 100% !important;
                margin: 0 0 6px !important;
                font-size: 16px !important;
                font-weight: 700 !important;
                line-height: 1.25 !important;
                color: #1f2937 !important;
                display: -webkit-box !important;
                -webkit-box-orient: vertical !important;
                -webkit-line-clamp: 2 !important;
                overflow: hidden !important;
                overflow-wrap: anywhere !important;
            }

            #pageContent .card p {
                width: 100% !important;
                margin: 0 !important;
                font-size: 13px !important;
                line-height: 1.4 !important;
                color: #6b7280 !important;
                display: -webkit-box !important;
                -webkit-box-orient: vertical !important;
                -webkit-line-clamp: 2 !important;
                overflow: hidden !important;
                overflow-wrap: anywhere !important;
            }

            #pageContent .card.focused {
                opacity: 1 !important;
                filter: none !important;
                pointer-events: auto !important;
                cursor: pointer !important;
                border: 1px solid #d1d5db !important;
                box-shadow: 0 10px 25px rgba(0, 0, 0, 0.08) !important;
            }

                #pageContent .card.focused .icon-box {
                    background: linear-gradient(135deg, #08b8a5, #009f78) !important;
                }

                    #pageContent .card.focused .icon-box img {
                        filter: brightness(0) invert(1) !important;
                    }

            #pageContent .card.faded {
                opacity: .55 !important;
                filter: grayscale(.3) !important;
                pointer-events: none !important;
                cursor: not-allowed !important;
            }

    @@media (max-width: 360px) {
        #pageContent, #pageContent.content {
            gap: 10px !important;
            padding: 10px !important;
        }

            #pageContent .card {
                padding: 10px 6px !important;
                border-radius: 15px !important;
            }

                #pageContent .card .icon-box {
                    width: 44px !important;
                    height: 44px !important;
                    min-width: 44px !important;
                    min-height: 44px !important;
                    margin-bottom: 8px !important;
                }

                    #pageContent .card .icon-box img {
                        width: 26px !important;
                        height: 26px !important;
                    }

                #pageContent .card h3 {
                    font-size: 14px !important;
                }

                #pageContent .card p {
                    font-size: 12px !important;
                }
    }

    .chat-confirm-overlay {
        position: fixed;
        inset: 0;
        background: rgba(0, 0, 0, 0.7);
        z-index: 100001;
        display: none;
        align-items: center;
        justify-content: center;
        padding: 24px 16px;
        box-sizing: border-box;
    }

        .chat-confirm-overlay.show {
            display: flex;
        }

    .chat-confirm-modal {
        width: 100%;
        max-width: 320px;
        background: #ffffff;
        border-radius: 20px;
        padding: 24px 20px 20px 20px;
        box-sizing: border-box;
        text-align: center;
        box-shadow: 0 12px 32px rgba(0, 0, 0, 0.25);
    }

    .chat-confirm-icon {
        width: 56px;
        height: 56px;
        margin: 0 auto 12px auto;
        border-radius: 50%;
        background: linear-gradient(135deg, #08b8a5, #009f78);
        display: flex;
        align-items: center;
        justify-content: center;
        color: #ffffff;
        font-size: 24px;
    }

    .chat-confirm-modal h3 {
        margin: 0 0 6px 0;
        font-size: 18px;
        font-weight: 800;
        color: #1f2937;
    }

    .chat-confirm-modal p {
        margin: 0 0 20px 0;
        font-size: 14px;
        color: #6b7280;
        line-height: 1.4;
    }

    .chat-confirm-actions {
        display: flex;
        gap: 10px;
    }

        .chat-confirm-actions button {
            flex: 1;
            height: 44px;
            border-radius: 12px;
            font-size: 15px;
            font-weight: 700;
            border: none;
            cursor: pointer;
        }

    .chat-confirm-cancel {
        background: #f3f4f6;
        color: #374151;
    }

    .chat-confirm-ok {
        background: linear-gradient(135deg, #08b8a5, #009f78);
        color: #ffffff;
    }

    .video-overlay {
        position: fixed;
        inset: 0;
        background: rgba(0,0,0,0.82);
        display: none;
        align-items: center;
        justify-content: center;
        padding: 24px 16px;
        box-sizing: border-box;
        z-index: 100000;
        overflow: hidden;
    }

        .video-overlay.show {
            display: flex;
        }

    .video-modal {
        position: relative;
        width: 100%;
        max-width: 420px;
        max-height: 90%;
        display: flex;
        flex-direction: column;
        background: transparent;
        overflow: hidden;
        margin-top: -40px;
    }

    .video-modal-body {
        flex: 1 1 auto;
        min-height: 0;
        overflow-y: auto;
        -webkit-overflow-scrolling: touch;
        display: flex;
        flex-direction: column;
        gap: 16px;
    }

        .video-modal-body .video-frame {
            position: relative;
            width: 100%;
            padding-bottom: 56.25%;
            height: 0;
            border-radius: 10px;
            overflow: hidden;
            background: #000;
            box-shadow: 0 8px 24px rgba(0,0,0,0.4);
            flex-shrink: 0;
        }

            .video-modal-body .video-frame iframe {
                position: absolute;
                top: 0;
                left: 0;
                width: 100%;
                height: 100%;
                border: none;
            }

    .video-overlay-back {
        width: 100%;
        height: 48px;
        margin-top: 16px;
        background: rgba(255,255,255,0.15);
        border: 1px solid rgba(255,255,255,0.3);
        border-radius: 12px;
        font-size: 15px;
        font-weight: 700;
        color: #ffffff;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        flex-shrink: 0;
    }

    .modal-overlay {
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        width: 100%;
        height: 100%;
        background: rgba(0, 0, 0, 0.5);
        display: none;
        align-items: center;
        justify-content: center;
        z-index: 999999;
        padding: 20px;
        box-sizing: border-box;
    }

        .modal-overlay.show {
            display: flex !important;
        }

    .request-modal {
        position: relative;
        width: 100%;
        max-width: 360px;
        background: #ffffff;
        border-radius: 24px;
        padding: 24px 20px 0;
        text-align: center;
        box-sizing: border-box;
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.15);
        margin: auto;
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
        animation: slideUpModal 0.3s ease-out;
        overflow: hidden;
    }

    @@keyframes slideUpModal {
        from {
            transform: translateY(20px);
            opacity: 0;
        }

        to {
            transform: translateY(0);
            opacity: 1;
        }
    }

    .modal-close-btn {
        position: absolute;
        top: 16px;
        right: 16px;
        width: 30px;
        height: 30px;
        border-radius: 50%;
        background: #f1f5f9;
        border: none;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        box-shadow: none;
        padding: 0;
        z-index: 10;
        color: #64748b;
        font-size: 14px;
        font-weight: 700;
        line-height: 1;
    }

        .modal-close-btn:hover {
            background: #e2e8f0;
        }

    .modal-avatar {
        width: 90px;
        height: 90px;
        margin: 0 auto 12px;
        border-radius: 50%;
        background: #e2e8f0;
        border: 4px solid #1abc9c;
        display: flex;
        align-items: center;
        justify-content: center;
        overflow: hidden;
    }

        .modal-avatar img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            display: block;
        }

    .modal-request-id {
        text-align: center;
        font-size: 15px;
        color: #1e293b;
        margin-bottom: 16px;
    }

        .modal-request-id strong {
            font-weight: 700;
            color: #0f172a;
        }

    .modal-details {
        text-align: center;
        font-size: 14px;
        color: #475569;
        line-height: 1.5;
        margin-bottom: 20px;
        word-break: break-word;
    }

        .modal-details p {
            margin: 0 0 6px;
        }

        .modal-details strong {
            font-weight: 700;
            color: #0f172a;
        }

    .eta-status-pill-box {
        display: flex;
        align-items: center;
        justify-content: center;
        background: #f8fafc;
        border-radius: 16px;
        padding: 16px 20px;
        margin-bottom: 20px;
        gap: 0;
    }

    .eta-item {
        flex: 1 1 0;
        min-width: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 10px;
    }

    .pill-icon {
        width: 28px;
        height: 28px;
        border-radius: 50%;
        background: #e2e8f0;
        display: flex;
        align-items: center;
        justify-content: center;
        margin-bottom: 0;
        font-size: 14px;
        color: #1abc9c;
        flex-shrink: 0;
    }

    .pill-text {
        display: flex;
        flex-direction: column;
        text-align: left;
        min-width: 0;
    }

        .pill-text small {
            display: block;
            font-size: 10px;
            color: #94a3b8;
            text-transform: uppercase;
            font-weight: 600;
            letter-spacing: 0.5px;
            margin-bottom: 0;
        }

        .pill-text strong {
            font-size: 14px;
            font-weight: 700;
            color: #0f172a;
        }

    .pill-divider {
        width: 1px;
        height: 30px;
        background: #cbd5e1;
        flex-shrink: 0;
        margin: 0 8px;
    }

    .success-track-btn {
        width: 100%;
        border: none;
        border-radius: 30px;
        background: #1abc9c;
        color: #fff;
        font-size: 15px;
        font-weight: 700;
        padding: 14px;
        cursor: pointer;
        transition: background 0.2s;
        margin-bottom: 0;
    }

        .success-track-btn:hover {
            background: #16a085;
        }

    .modal-footer-pagination {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 8px;
        padding: 16px 0;
        border-top: 1px solid #f1f5f9;
        margin-top: 20px;
        font-size: 13px;
        color: #1e293b;
        font-weight: 500;
        width: 100%;
        box-sizing: border-box;
        overflow: hidden;
    }

    .nav-link {
        cursor: pointer;
        padding: 6px 4px;
        user-select: none;
        white-space: nowrap;
        flex-shrink: 0;
        color: #1e293b;
        font-weight: 500;
        transition: opacity 0.2s;
    }

        .nav-link:hover {
            text-decoration: underline;
        }

        .nav-link.disabled {
            opacity: 0.35;
            cursor: not-allowed;
            pointer-events: none;
            text-decoration: none;
        }

    .dots {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 6px;
        flex: 1 1 auto;
        min-width: 0;
        overflow: hidden;
    }

        .dots .dot {
            width: 8px;
            height: 8px;
            border-radius: 50%;
            background: #cbd5e1;
            cursor: pointer;
            flex-shrink: 0;
            transition: background 0.2s, transform 0.2s;
        }

            .dots .dot.active {
                background: #3b82f6;
                transform: scale(1.15);
            }

            .dots .dot:hover {
                background: #94a3b8;
            }

        .dots .dot-gap {
            width: auto;
            height: auto;
            background: transparent;
            color: #94a3b8;
            font-size: 12px;
            line-height: 1;
            padding: 0 1px;
            cursor: default;
            flex-shrink: 0;
            user-select: none;
        }

    #assistantTitlebar .assistant-back-btn,
    #assistantBackBtn {
        width: 30px !important;
        height: 30px !important;
        min-width: 30px !important;
        padding: 0 !important;
    }

    #assistantTitlebar .back-arrow-icon {
        width: 16px !important;
        height: auto !important;
    }

    #assistantTitlebar .assistant-title {
        font-size: 17px !important;
        line-height: 1 !important;
        margin: 0 !important;
    }

    .request-loading-overlay {
        position: fixed;
        inset: 0;
        width: 100%;
        height: 100%;
        background: rgba(15, 23, 42, 0.35);
        display: none;
        align-items: center;
        justify-content: center;
        z-index: 9999999;
        padding: 20px;
        box-sizing: border-box;
    }

        .request-loading-overlay.show {
            display: flex;
        }

    .request-loading-modal {
        position: relative;
        width: 100%;
        max-width: 360px;
        min-height: 360px;
        background: #ffffff;
        border-radius: 24px;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        text-align: center;
        overflow: hidden;
        box-sizing: border-box;
        box-shadow: 0 20px 50px rgba(0, 0, 0, 0.20);
        padding: 40px 25px;
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
        animation: loadingModalIn 0.25s ease-out;
    }

        .request-loading-modal::before {
            content: "";
            position: absolute;
            inset: 0;
            opacity: 0.38;
            pointer-events: none;
            background-image: linear-gradient(30deg, #edf1f4 12%, transparent 12.5%, transparent 87%, #edf1f4 87.5%, #edf1f4), linear-gradient(150deg, #edf1f4 12%, transparent 12.5%, transparent 87%, #edf1f4 87.5%, #edf1f4), linear-gradient(30deg, #edf1f4 12%, transparent 12.5%, transparent 87%, #edf1f4 87.5%, #edf1f4), linear-gradient(150deg, #edf1f4 12%, transparent 12.5%, transparent 87%, #edf1f4 87.5%, #edf1f4), linear-gradient(60deg, #f5f7f8 25%, transparent 25.5%, transparent 75%, #f5f7f8 75%);
            background-size: 80px 140px;
            background-position: 0 0, 0 0, 40px 70px, 40px 70px, 0 0;
        }

    .loading-icon-wrapper {
        position: relative;
        width: 130px;
        height: 130px;
        display: flex;
        align-items: center;
        justify-content: center;
        margin-bottom: 28px;
        z-index: 2;
    }

    .loading-icon-circle {
        width: 108px;
        height: 108px;
        border-radius: 50%;
        background: #f0f5f9;
        display: flex;
        align-items: center;
        justify-content: center;
        position: relative;
        z-index: 2;
    }

        .loading-icon-circle i {
            color: #009f94;
            font-size: 42px;
        }

    .loading-ring {
        position: absolute;
        width: 124px;
        height: 124px;
        border-radius: 50%;
        border: 4px solid transparent;
        pointer-events: none;
        z-index: 3;
    }

    .ring-1 {
        border-top-color: #00b8a9;
        border-right-color: #00b8a9;
        animation: loadingSpin 1.3s linear infinite;
    }

    .ring-2 {
        border-bottom-color: #00b8a9;
        border-left-color: #00b8a9;
        animation: loadingSpinReverse 1.3s linear infinite;
    }

    .loading-title {
        position: relative;
        z-index: 2;
        color: #10233d;
        font-size: 24px;
        line-height: 32px;
        font-weight: 700;
        margin-bottom: 8px;
    }

    .loading-subtitle {
        position: relative;
        z-index: 2;
        color: #55708f;
        font-size: 15px;
        line-height: 22px;
        font-weight: 400;
    }

    @@keyframes loadingSpin {
        from {
            transform: rotate(0deg);
        }

        to {
            transform: rotate(360deg);
        }
    }

    @@keyframes loadingSpinReverse {
        from {
            transform: rotate(360deg);
        }

        to {
            transform: rotate(0deg);
        }
    }

    @@keyframes loadingModalIn {
        from {
            opacity: 0;
            transform: scale(0.94);
        }

        to {
            opacity: 1;
            transform: scale(1);
        }
    }

    @@media (max-width: 480px) {
        .request-loading-modal {
            max-width: 340px;
            min-height: 340px;
        }
    }

    @@media (min-width: 768px) {

        html body {
            height: 100vh !important;
            max-height: 100vh !important;
            overflow: hidden !important;
            display: flex !important;
            flex-direction: column !important;
            margin: 0 !important;
            padding: 0 !important;
        }

            html body .app-wrapper {
                height: 100vh !important;
                max-height: 100vh !important;
                display: flex !important;
                flex-direction: column !important;
                overflow: hidden !important;
                margin: 0 !important;
                padding: 0 !important;
            }

            html body #pageContent.content {
                display: grid !important;
                grid-template-columns: repeat(3, minmax(0, 1fr)) !important;
                grid-auto-rows: minmax(200px, auto) !important;
                gap: 16px !important;
                align-items: stretch !important;
                align-content: start !important;
                width: 100% !important;
                max-width: 1400px !important;
                margin: 0 auto !important;
                padding: 16px !important;
                flex: 1 1 auto !important;
                min-height: 0 !important;
                height: 100% !important;
                max-height: 100% !important;
                box-sizing: border-box !important;
                overflow-y: auto !important;
                overflow-x: hidden !important;
            }

                html body #pageContent.content > .card {
                    grid-column: auto !important;
                    grid-row: auto !important;
                    width: 100% !important;
                    height: 100% !important;
                    min-height: 0 !important;
                    max-height: none !important;
                    margin: 0 !important;
                    border-radius: 24px !important;
                    box-sizing: border-box !important;
                    overflow: hidden !important;
                    padding: 24px 20px !important;
                    text-align: center !important;
                    background: #ffffff !important;
                    display: flex !important;
                    flex-direction: column !important;
                    align-items: center !important;
                    justify-content: center !important;
                    border: 1px solid #eef1f5 !important;
                    box-shadow: 0 6px 14px rgba(0, 0, 0, 0.04) !important;
                }

                    html body #pageContent.content > .card .icon-box {
                        width: 80px !important;
                        height: 80px !important;
                        margin: 0 auto 16px auto !important;
                        display: flex !important;
                        align-items: center !important;
                        justify-content: center !important;
                        border-radius: 20px !important;
                        background: #f3f4f6 !important;
                        flex-shrink: 0 !important;
                    }

                        html body #pageContent.content > .card .icon-box img {
                            width: 48px !important;
                            height: 48px !important;
                            object-fit: contain !important;
                        }

                    html body #pageContent.content > .card h3 {
                        margin: 0 0 8px !important;
                        font-size: 18px !important;
                        font-weight: 700 !important;
                        color: #1f2937 !important;
                    }

                    html body #pageContent.content > .card p {
                        margin: 0 !important;
                        font-size: 13px !important;
                        line-height: 1.4 !important;
                        color: #6b7280 !important;
                    }

                    html body #pageContent.content > .card.focused {
                        opacity: 1 !important;
                        filter: none !important;
                        pointer-events: auto !important;
                        cursor: pointer !important;
                        box-shadow: 0 16px 28px rgba(0, 60, 100, 0.12), 0 4px 10px rgba(0, 0, 0, 0.05) !important;
                        border: 1px solid rgba(120, 180, 255, 0.3) !important;
                    }

                        html body #pageContent.content > .card.focused .icon-box {
