</style>

<script>
    (function () {
        try { sessionStorage.removeItem("autoStartCall"); } catch (e) { }
    })();
</script>

<div class="app-wrapper">

    <partial name="_header"></partial>
    <div id="pageNav">
        <partial name="_nav"></partial>
    </div>

    <div class="assistant-titlebar" id="assistantTitlebar">
        <button type="button" class="assistant-back-btn" id="assistantBackBtn" aria-label="Go back">
            <img src="~/images/voice-agent/arrow.png" alt="Back" class="back-arrow-icon">
        </button>
        <h1 class="assistant-title">My Daily Care</h1>
    </div>

    <input type="hidden" id="hdnTaskTypeId">

    <div class="content" id="pageContent"></div>

    <div class="chat-confirm-overlay" id="chatConfirmOverlay">
        <div class="chat-confirm-modal">
            <div class="chat-confirm-icon">
                <i class="fa-solid fa-circle-play"></i>
            </div>
            <h3>AI Assistant</h3>
            <p>Would you like to continue with Thara, your AI Assistant?</p>
            <div class="chat-confirm-actions">
                <button type="button" class="chat-confirm-cancel" onclick="closeChatConfirm()">Not now</button>
                <button type="button" class="chat-confirm-ok" onclick="confirmGoToChat()">Continue</button>
            </div>
        </div>
    </div>

    <partial name="_footer"></partial>

    <div class="video-overlay" id="videoOverlay">
        <div class="video-modal">
            <div class="video-modal-body" id="videoModalBody"></div>
            <button class="video-overlay-back" onclick="goBackFromVideo()" aria-label="Back">
                ← Back to My Daily Care
            </button>
        </div>
    </div>

    <div id="requestLoadingScreen" class="modal-overlay request-loading-overlay">
        <div class="request-loading-modal">

            <div class="loading-icon-wrapper">
                <div class="loading-ring ring-1"></div>
                <div class="loading-ring ring-2"></div>

                <div class="loading-icon-circle">
                    <i class="fa-solid fa-wrench"></i>
                </div>
            </div>

            <div class="loading-title">
                Sending Request...
            </div>

            <div class="loading-subtitle">
                Connecting to support station
            </div>

        </div>
    </div>

    <div id="requestSuccessScreen" class="modal-overlay">
        <div class="request-modal">
            <button type="button" class="modal-close-btn" onclick="closeSuccessModal()" aria-label="Close">
                <i class="fa-solid fa-xmark"></i>
            </button>
            <div class="modal-avatar">
                <img src="/images/porter.png" alt="Staff"
                     onerror="this.onerror=null;this.src='/images/porter.png';">
            </div>

            <div class="modal-request-id">
                Request Id: <strong id="successReqId">#-</strong>
            </div>

            <div class="modal-details">
                <p>
                    Support staff
                    <strong id="successStaffName">-</strong> assigned.
                </p>
                <p>
                    Task Name:
                    <strong id="successTaskName">-</strong>
                </p>
            </div>

            <div class="eta-status-pill-box">
                <div class="eta-item">
                    <div class="pill-icon"><i class="fa-regular fa-clock"></i></div>
                    <div class="pill-text">
                        <small>ETA</small>
                        <strong id="successEta">-</strong>
                    </div>
                </div>
                <div class="pill-divider"></div>
                <div class="eta-item">
                    <div class="pill-icon"><i class="fa-solid fa-location-dot"></i></div>
                    <div class="pill-text">
                        <small>STATUS</small>
                        <strong id="successStatus" style="color:#00a86b;">-</strong>
                    </div>
                </div>
            </div>

            <button type="button" class="success-track-btn" onclick="goToTracking()">
                Track Status
            </button>

            <div class="modal-footer-pagination">
                <span class="nav-link" id="btnPrevRequest" onclick="prevRequest()">&lt; Previous</span>
                <div class="dots" id="dotsContainer"></div>
                <span class="nav-link" id="btnNextRequest" onclick="nextRequest()">Next &gt;</span>
            </div>
        </div>
    </div>

    <script>

        var isUnifiedAIFrame = @(isUnifiedAIFrame ? "true" : "false");

        var curpage = window.location.pathname.split("/").pop();

        var urlParams = new URLSearchParams(window.location.search);
        var bed     = BedContext.get();
        var bedInfo = bed.bedInfo;
        var region  = bed.region;

        var lastVideoRequestId = null;
        var pendingSuccessTaskId = null;
        var pendingVideoData = null;
        var _isNavigatingBack = false;

        function isCallActive() {
            var state = document.body ? document.body.getAttribute('data-state') : null;
            return state === 'connecting' || state === 'connected';
        }

        document.addEventListener("DOMContentLoaded", function () {
            document.querySelectorAll(".navBtn").forEach(function (button) {
                if (button.dataset.page === curpage) button.classList.add("active");

                button.addEventListener("click", function () {
                    BedContext.go(this.getAttribute("data-page"));
                });
            });

            var backBtn = document.getElementById('assistantBackBtn');
            if (backBtn) {
                backBtn.addEventListener('click', function (e) {
                    e.preventDefault();
                    e.stopPropagation();

                    if (isUnifiedAIFrame || window.UnifiedAIChild) {
                        if (window.parent && window.parent !== window) {
                            window.parent.postMessage({ type: 'unified_ai_show_home' }, window.location.origin);
                        } else {
                            BedContext.go('Home/Index');
                        }
                        return;
                    }

                    pendingSuccessTaskId = null;
                    _postCallFetchInFlight = true;
                    hideRequestLoading();
                    BedContext.go('Home/Index');
                });
            }
        });

        function navigateToDailyCare() {
            window.scrollTo(0, 0);
        }

        function DailCareRedirect(RedirectURL) {
            var b = BedContext.get();
            if (!b.bedInfo) return;
            var url = RedirectURL + encodeURIComponent(b.bedInfo)
                + '&region=' + encodeURIComponent(b.region || 'IN');
            if (b.tenantId) {
                url += '&XTenantID=' + encodeURIComponent(b.tenantId);
            }
            var isFrame = @(isUnifiedAIFrame ? "true" : "false");
            if (window.UnifiedAIChild && typeof window.UnifiedAIChild.navigate === 'function') {
                window.UnifiedAIChild.navigate(url);
            } else if (isFrame) {
                var sep = url.indexOf('?') > -1 ? '&' : '?';
                window.location.href = url + sep + 'Unified=1&UnifiedAI=1';
            } else {
                window.location.href = url;
            }
        }

        function convertToEmbedUrl(url) {
            if (!url) return '';
            if (url.indexOf('youtube.com/embed') > -1) return url;

            var videoId = '';
            if (url.indexOf('youtu.be/') > -1) {
                videoId = url.split('youtu.be/')[1].split('?')[0];
            } else if (url.indexOf('youtube.com/watch') > -1) {
                var params = url.split('?')[1];
                if (params) {
                    params.split('&').forEach(function (p) {
                        if (p.indexOf('v=') === 0) videoId = p.substring(2);
                    });
                }
            } else if (url.indexOf('youtube.com/shorts/') > -1) {
                videoId = url.split('shorts/')[1].split('?')[0];
            }

            return videoId
                ? 'https://www.youtube.com/embed/' + videoId + '?rel=0&modestbranding=1'
                : url;
        }

        function openVideoOverlay(videoUrlOrList, title) {
                    var raw = Array.isArray(videoUrlOrList)
                        ? videoUrlOrList.join(" ")
                        : String(videoUrlOrList || "").trim();
                    if (!raw && !title) return;

                    if (pendingSuccessTaskId) {
                        try {
                            var bedKey = getTaskBedId() || getTaskBedNumber() || "unknown";
                            sessionStorage.setItem("pendingSuccessTaskId_" + bedKey, pendingSuccessTaskId);
                        } catch (e) { }
                    }

                    try {
                        sessionStorage.setItem("pendingLibraryVideo", JSON.stringify({
                            videoUrl: raw,
                            title: title || ""
                        }));
                    } catch (e) { }

                    if (window.UnifiedAIChild && typeof window.UnifiedAIChild.navigate === "function") {
                        var childUrl = window.BedContext && window.BedContext.url
                            ? window.BedContext.url("MyLibrary/Index", { playVideo: raw, videoTitle: title || "" })
                            : "/MyLibrary/Index?playVideo=" + encodeURIComponent(raw)
                                + "&videoTitle=" + encodeURIComponent(title || "");
                        window.UnifiedAIChild.navigate(childUrl);
                        return;
                    }

                    if (isUnifiedAIFrame) {
                        var frameUrl = window.BedContext && window.BedContext.url
                            ? window.BedContext.url("MyLibrary/Index", { playVideo: raw, videoTitle: title || "" })
                            : "/MyLibrary/Index?playVideo=" + encodeURIComponent(raw)
                                + "&videoTitle=" + encodeURIComponent(title || "");
                        var sep = frameUrl.indexOf("?") > -1 ? "&" : "?";
                        window.location.href = frameUrl + sep + "Unified=1&UnifiedAI=1";
                        return;
                    }

                    if (window.BedContext && typeof window.BedContext.go === "function") {
                        BedContext.go("MyLibrary/Index", { playVideo: raw, videoTitle: title || "" });
                    } else {
                        window.location.href = "/MyLibrary/Index?playVideo=" + encodeURIComponent(raw)
                            + "&videoTitle=" + encodeURIComponent(title || "");
                    }
                }

        function closeVideoOverlay() {
            var overlay = document.getElementById('videoOverlay');
            var body    = document.getElementById('videoModalBody');
            body.innerHTML = '';
            overlay.classList.remove('show');
            document.body.style.overflow = '';

            if (pendingSuccessTaskId) {
                var reqId = pendingSuccessTaskId;
                pendingSuccessTaskId = null;
                showSuccessModal(reqId);
            }
        }

        function goBackFromVideo() {
            var hasPending = !!pendingSuccessTaskId;
            closeVideoOverlay();
            if (hasPending) {
                return;
            }

            navigateToDailyCare();
        }

        window.openVideoOverlay  = openVideoOverlay;
        window.closeVideoOverlay = closeVideoOverlay;
        window.goBackFromVideo   = goBackFromVideo;

        window.addEventListener("unified-ai:action", function (event) {
            var action = event.detail;
            if (!action || (action.action !== "video.play" && action.action !== "video.stop")) return;

            if (action.action === "video.stop") {
                closeVideoOverlay();
                if (window.UnifiedAIChild) window.UnifiedAIChild.respond(action, true, { stopped: true });
                return;
            }

            if (!action.videoUrl || !String(action.videoUrl).trim()) {
                if (window.UnifiedAIChild) window.UnifiedAIChild.respond(action, false, null, "A video URL is required.");
                return;
            }
            openVideoOverlay(action.videoUrl, action.title || action.categoryName || "");
            var isOpen = document.getElementById("videoOverlay").classList.contains("show");
            if (window.UnifiedAIChild) {
                window.UnifiedAIChild.respond(action, isOpen, isOpen ? { opened: true } : null,
                    isOpen ? null : "The video could not be opened.");
            }
        });

        var lastSeenTaskId = null;
        var polling = true;
        var taskPollInFlight = false;

        var _successModalToken = 0;
        var _currentModalRequestId = null;

        function getTaskBedId()     { return BedContext.taskBedId(); }

        function getTaskBedNumber() { return BedContext.taskBedNumber(); }

        function getTaskField(obj, camel, pascal) {
            if (!obj) return '';
            if (obj[camel] !== undefined && obj[camel] !== null) return obj[camel];
            if (obj[pascal] !== undefined && obj[pascal] !== null) return obj[pascal];
            return '';
        }

        function getTaskId(r) {
            return String(
                getTaskField(r, 'taskId', 'TaskId') ||
                getTaskField(r, 'requestId', 'RequestId') ||
                ''
            ).trim();
        }

        function getTaskName(r) {
            return String(getTaskField(r, 'taskName', 'TaskName') || '').trim();
        }

        function getPorterName(r) {
            return String(getTaskField(r, 'porterName', 'PorterName') || '').trim();
        }

        function getTaskStatus(r) {
            return String(getTaskField(r, 'status', 'Status') || '').trim().toUpperCase();
        }

        function getTaskEta(r) {
            return String(
                getTaskField(r, 'eta', 'Eta') ||
                getTaskField(r, 'ETA', 'ETA') ||
                ''
            ).trim();
        }

        function getTaskRequestDate(r) {
            var raw = getTaskField(r, 'requestDate', 'RequestDate');
            if (!raw) return null;
            if (raw instanceof Date) return isNaN(raw) ? null : raw;

            var s = String(raw).trim();
            var iso = new Date(s);
            if (!isNaN(iso)) return iso;

            var m = s.match(/^(\d{1,2})\/(\d{1,2})\/(\d{4})(?:[ T](\d{1,2}):(\d{2})(?::(\d{2}))?)?/);
            if (m) {
                var d = new Date(
                    parseInt(m[3], 10),
                    parseInt(m[1], 10) - 1,
                    parseInt(m[2], 10),
                    parseInt(m[4] || '0', 10),
                    parseInt(m[5] || '0', 10),
                    parseInt(m[6] || '0', 10)
                );
                return isNaN(d) ? null : d;
            }
            return null;
        }

        function statusColorFor(status) {
            switch ((status || '').toUpperCase()) {
                case 'READY':
                case 'ACCEPTED':
                case 'ASSIGNED':
                    return '#3b82f6';
                case 'IN-PROGRESS':
                case 'INPROGRESS':
                case 'EXECUTED':
                    return '#3b82f6';
                case 'COMPLETED':
                case 'DELIVERED':
                    return '#10b981';
                case 'CANCELLED':
                case 'CANCELED':
                    return '#ef4444';
                case 'ONHOLD':
                    return '#f59e0b';
                default:
                    return '#00a86b';
            }
        }

        function resolveEta(rawEta, porterName) {
            var eta = String(rawEta || '').trim();
            if (eta && eta !== '-') return eta;

            var hasPorter = porterName && porterName.trim() !== '';
            if (hasPorter) return '5 Mins';

            return '-';
        }

        var successRequests = [];
        var successIndex = 0;

        function getJson(url, data) {
            return Promise.resolve($.ajax({
                url: url,
                type: 'GET',
                data: data,
                dataType: 'json',
                cache: false,
                timeout: 8000
            })).catch(function () { return null; });
        }

        function fetchTasksForModal() {
            return getJson('/Home/GetTasks', {
                BedId: getTaskBedId(),
                BedNumber: getTaskBedNumber()
            }).then(function (data) {
                return Array.isArray(data) ? data : [];
            });
        }

        var STATUS_PRIORITY = {
            'PENDING': 1, 'READY': 2, 'ACCEPTED': 2, 'ASSIGNED': 3,
            'IN-PROGRESS': 4, 'INPROGRESS': 4, 'EXECUTED': 5,
            'DELIVERED': 5, 'COMPLETED': 6, 'CANCELLED': 7,
            'CANCELED': 7, 'ONHOLD': 8
        };

        function groupAllByRequestId(rows) {
            var map = {};
            var order = [];

            rows.forEach(function (r) {
                var id = getTaskId(r);
                if (!id) return;

                if (!map[id]) {
                    map[id] = {
                        RequestId: id,
                        TaskNames: [],
                        PorterName: '',
                        Status: 'PENDING',
                        Eta: '',
                        RequestDate: getTaskRequestDate(r)
                    };
                    order.push(id);
                }

                var taskName = getTaskName(r);
                if (taskName && map[id].TaskNames.indexOf(taskName) === -1) {
                    map[id].TaskNames.push(taskName);
                }

                var porter = getPorterName(r);
                if (!map[id].PorterName && porter !== '') {
                    map[id].PorterName = porter;
                }

                var rowStatus = getTaskStatus(r);
                var curStatus = String(map[id].Status || '').toUpperCase();

                if ((STATUS_PRIORITY[rowStatus] || 1) > (STATUS_PRIORITY[curStatus] || 1)) {
                    map[id].Status = rowStatus;
                }

                var eta = getTaskEta(r);
                if (eta && (!map[id].Eta || map[id].Eta === '' || map[id].Eta === '-')) {
                    map[id].Eta = eta;
                }

                var rd = getTaskRequestDate(r);
                if (rd && (!map[id].RequestDate || rd > map[id].RequestDate)) {
                    map[id].RequestDate = rd;
                }
            });

            return order.map(function (id) {
                var g = map[id];
                g.TaskName = g.TaskNames.join(', ');
                delete g.TaskNames;
                g.Eta = resolveEta(g.Eta, g.PorterName);
                return g;
            });
        }

        function paintTaskRequest() {
            if (!successRequests.length) {
                successRequests = [{
                    RequestId: '',
                    TaskName: '',
                    PorterName: '',
                    Status: 'PENDING',
                    Eta: '-'
                }];
                successIndex = 0;
            }

            if (successIndex < 0) successIndex = 0;
            if (successIndex > successRequests.length - 1) successIndex = successRequests.length - 1;

            var req = successRequests[successIndex];
            var porter = (req.PorterName || '').trim();

            var reqIdEl = document.getElementById('successReqId');
            var staffEl = document.getElementById('successStaffName');
            var taskEl = document.getElementById('successTaskName');
            var etaEl = document.getElementById('successEta');
            var statEl = document.getElementById('successStatus');

            if (reqIdEl) reqIdEl.textContent = req.RequestId ? '#' + req.RequestId : '#-';
            if (staffEl) staffEl.textContent = porter ? porter.toUpperCase() : 'will be';
            if (taskEl) taskEl.textContent = req.TaskName || '-';
            if (etaEl) etaEl.textContent = req.Eta || '-';

            if (statEl) {
                statEl.textContent = req.Status ? req.Status.toUpperCase() : 'PENDING';
                statEl.style.color = statusColorFor(req.Status);
            }

            var dotsEl = document.getElementById('dotsContainer');
            if (dotsEl) {
                var total = successRequests.length;
                var maxDots = 7;

                if (total <= maxDots) {
                    dotsEl.innerHTML = successRequests.map(function (r, i) {
                        return '<span class="dot' + (i === successIndex ? ' active' : '') +
                            '" onclick="goToRequestIndex(' + i + ')"></span>';
                    }).join('');
                } else {
                    var half = Math.floor(maxDots / 2);
                    var start = successIndex - half;
                    var end = successIndex + half;

                    if (start < 0) { start = 0; end = maxDots - 1; }
                    if (end > total - 1) { end = total - 1; start = total - maxDots; }

                    var html = '';

                    if (start > 0) {
                        html += '<span class="dot" onclick="goToRequestIndex(0)"></span>';
                        if (start > 1) html += '<span class="dot-gap">…</span>';
                    }

                    for (var i = start; i <= end; i++) {
                        html += '<span class="dot' + (i === successIndex ? ' active' : '') +
                            '" onclick="goToRequestIndex(' + i + ')"></span>';
                    }

                    if (end < total - 1) {
                        if (end < total - 2) html += '<span class="dot-gap">…</span>';
                        html += '<span class="dot" onclick="goToRequestIndex(' + (total - 1) + ')"></span>';
                    }

                    dotsEl.innerHTML = html;
                }
            }

            var prevEl = document.getElementById('btnPrevRequest');
            var nextEl = document.getElementById('btnNextRequest');

            if (prevEl) {
                if (successIndex === 0) prevEl.classList.add('disabled');
                else prevEl.classList.remove('disabled');
            }

            if (nextEl) {
                if (successIndex === successRequests.length - 1) nextEl.classList.add('disabled');
                else nextEl.classList.remove('disabled');
            }
        }

        function goToRequestIndex(i) {
            if (i < 0 || i > successRequests.length - 1) return;
            successIndex = i;
            paintTaskRequest();
        }

        function prevRequest() {
            if (successIndex <= 0) return;
            successIndex--;
            paintTaskRequest();
        }

        function nextRequest() {
            if (successIndex >= successRequests.length - 1) return;
            successIndex++;
            paintTaskRequest();
        }

        function showSuccessModal(requestNo) {
            var overlay = document.getElementById('requestSuccessScreen');
            if (!overlay) return;

            var normalized = requestNo ? String(requestNo) : null;
            if (!normalized) return;

            if (_currentModalRequestId === normalized) return;

            _currentModalRequestId = normalized;
            saveLastSeenTaskId(normalized);

            var myToken = ++_successModalToken;

            showRequestLoading();

            function reveal() {
                if (myToken !== _successModalToken) return;
                overlay.classList.add('show');
                overlay.style.display = '';
                document.body.style.overflow = 'hidden';
                hideRequestLoading();
            }

            fetchTasksForModal().then(function (rows) {
                if (myToken !== _successModalToken) return;

                successRequests = groupAllByRequestId(rows);

                if (!successRequests.length) {
                    successRequests = [{
                        RequestId: normalized,
                        TaskName: '',
                        PorterName: '',
                        Status: 'PENDING',
                        Eta: '-'
                    }];
                    successIndex = 0;
                } else {
                    successIndex = 0;
                    for (var i = 0; i < successRequests.length; i++) {
                        if (String(successRequests[i].RequestId) === normalized) {
                            successIndex = i;
                            break;
                        }
                    }
                }

                paintTaskRequest();
                reveal();
            }).catch(function () {
                if (myToken !== _successModalToken) return;

                successRequests = [{
                    RequestId: normalized,
                    TaskName: '',
                    PorterName: '',
                    Status: 'PENDING',
                    Eta: '-'
                }];
                successIndex = 0;
                paintTaskRequest();
                reveal();
            });
        }

        function showRequestLoading() {
            var loadingScreen = document.getElementById("requestLoadingScreen");

            if (loadingScreen) {
                loadingScreen.classList.add("show");
                document.body.style.overflow = "hidden";
            }
        }

        function hideRequestLoading() {
            var loadingScreen = document.getElementById("requestLoadingScreen");

            if (loadingScreen) {
                loadingScreen.classList.remove("show");
                document.body.style.overflow = "";
            }
        }

        window.showRequestLoading = showRequestLoading;
        window.hideRequestLoading = hideRequestLoading;

        function closeSuccessModal() {
            _successModalToken++;
            var overlay = document.getElementById('requestSuccessScreen');
            if (overlay) {
                overlay.classList.remove('show');
                overlay.style.display = '';
                document.body.style.overflow = '';
            }
            hideRequestLoading();
            _currentModalRequestId = null;
        }

        function goToTracking() {
            var req = successRequests[successIndex] || {};
            if (!req.RequestId) return;
            BedContext.go('Tracking', { RequestID: req.RequestId });
        }

        function getLastSeenTaskKey() {
            var bed = getTaskBedId() || getTaskBedNumber() || 'unknown';
            return 'lastSeenTaskId_' + bed;
        }

        function loadLastSeenTaskId() {
            try {
                lastSeenTaskId = sessionStorage.getItem(getLastSeenTaskKey()) || null;
            } catch (e) {
                lastSeenTaskId = null;
            }
        }

        function saveLastSeenTaskId(id) {
            lastSeenTaskId = String(id);
            try {
                sessionStorage.setItem(getLastSeenTaskKey(), String(id));
            } catch (e) { }
        }

        function pollForNewTask() {
            if (isCallActive()) return;
            var vOverlay = document.getElementById('videoOverlay');
            if (vOverlay && vOverlay.classList.contains('show')) return;
            if (taskPollInFlight) return;

            var bedId = getTaskBedId();
            var bedNumber = getTaskBedNumber();
            if (!bedId && !bedNumber) return;

            taskPollInFlight = true;

            getJson('/Home/GetFreshTask', {
                bedId: bedId,
                bedNumber: bedNumber,
                token: '',
                lastSeenTaskId: lastSeenTaskId || ''
            }).then(function (res) {
                taskPollInFlight = false;
                if (!res || !res.hasFreshTask) return;

                var taskId = String(res.taskId || '').trim();
                if (!taskId || taskId === String(lastSeenTaskId)) return;

                saveLastSeenTaskId(taskId);
                showSuccessModal(taskId);
            });
        }

        document.addEventListener("DOMContentLoaded", function () {
            loadLastSeenTaskId();

            var bedKey = getTaskBedId() || getTaskBedNumber() || 'unknown';
            var pendingVLinks = sessionStorage.getItem('pendingVideoLinks_' + bedKey);
            var pendingVTitle = sessionStorage.getItem('pendingVideoTitle_' + bedKey) || '';
            if (pendingVLinks) {
                sessionStorage.removeItem('pendingVideoLinks_' + bedKey);
                sessionStorage.removeItem('pendingVideoTitle_' + bedKey);
                if (isUnifiedAIFrame) {
                    pendingVideoData = null;
                } else if (!isCallActive()) {
                    openVideoOverlay(pendingVLinks, pendingVTitle);
                } else {
                    pendingVideoData = { links: pendingVLinks, title: pendingVTitle };
                }
            }

            var pendingFromChat = sessionStorage.getItem('pendingSuccessTaskId_' + bedKey);
            if (pendingFromChat) {
                sessionStorage.removeItem('pendingSuccessTaskId_' + bedKey);
                saveLastSeenTaskId(pendingFromChat);
                if (!isCallActive()) {
                    showSuccessModal(pendingFromChat);
                } else {
                    pendingSuccessTaskId = pendingFromChat;
                }
            }

            (function loop() {
                if (!polling) return;
                setTimeout(function () {
                    if (!polling) return;
                    if (!document.hidden && !isCallActive()) pollForNewTask();
                    loop();
                }, 5000);
            })();
            setTimeout(pollForNewTask, 500);
        });

        document.addEventListener("visibilitychange", function () {
            if (!document.hidden) pollForNewTask();
        });

        window.addEventListener("focus", function () {
            pollForNewTask();
        });

        window.addEventListener("message", function (e) {
            if (!e || !e.data) return;

            if (e.data.type === "call-ended") {
                if (pendingVideoData) {
                    openVideoOverlay(pendingVideoData.links, pendingVideoData.title);
                    pendingVideoData = null;
                }
                else if (typeof flushPendingPopups === "function") {
                    flushPendingPopups();
                }

                return;
            }

            if (e.data.type === "task-created" && e.data.requestId) {
                var incomingId = String(e.data.requestId);
                if (incomingId === String(lastSeenTaskId)) return;

                if (isCallActive()) {
                    pendingSuccessTaskId = incomingId;
                } else {
                    if (document.readyState === 'complete' || document.readyState === 'interactive') {
                        showSuccessModal(incomingId);
                    } else {
                        document.addEventListener('DOMContentLoaded', function () {
                            showSuccessModal(incomingId);
                        }, { once: true });
                    }
                }
            }
        });

        var _postCallFetchInFlight = false;
        function fetchPostCallUpdates() {
            if (_postCallFetchInFlight) return;
            _postCallFetchInFlight = true;

            setTimeout(function () {
                var bedNo = getTaskBedId();
                var bedId = getTaskBedId();
                var bedNumber = getTaskBedNumber();

                Promise.all([
                    bedNo ? getJson('/Home/CheckLatestVideo', { bedNo: bedNo }) : null,
                    (bedId || bedNumber)
                        ? getJson('/Home/GetFreshTask', {
                            bedId: bedId,
                            bedNumber: bedNumber,
                            token: '',
                            lastSeenTaskId: lastSeenTaskId || ''
                        })
                        : null
                ]).then(function (r) {
                    var v = r[0];
                    var t = r[1];

                    var taskId = (t && t.hasFreshTask) ? String(t.taskId || '').trim() : '';
                    if (taskId && taskId === String(lastSeenTaskId)) taskId = '';

                    var hasNewVideo = v && v.hasVideo && v.videoLinks && lastVideoRequestId !== v.requestId;

                    if (hasNewVideo) {
                        lastVideoRequestId = v.requestId;

                        if (!_isNavigatingBack) {
                            showRequestLoading();
                        }

                        if (taskId) {
                            saveLastSeenTaskId(taskId);
                            pendingSuccessTaskId = taskId;
                        }

                        setTimeout(function () {
                            if (_isNavigatingBack) return;
                            hideRequestLoading();
                            openVideoOverlay(v.videoLinks, v.categoryName);
                        }, 1500);

                    }

                    else if (taskId) {
                        saveLastSeenTaskId(taskId);
                        if (!_isNavigatingBack) {
                            showSuccessModal(taskId);
                        }
                    }

                    else {
                        hideRequestLoading();
                    }
                }).then(function () {
                    _postCallFetchInFlight = false;
                }, function () {
                    _postCallFetchInFlight = false;
                    hideRequestLoading();
                });
            }, 300);
        }

        window.addEventListener("beforeunload", function () {
            polling = false;
        });

        window.fetchPostCallUpdates = fetchPostCallUpdates;
        window.flushPendingPopups = fetchPostCallUpdates;
        window.showSuccessModal = showSuccessModal;
        window.closeSuccessModal = closeSuccessModal;
        window.goToTracking = goToTracking;
        window.prevRequest = prevRequest;
        window.nextRequest = nextRequest;
        window.goToRequestIndex = goToRequestIndex;
    </script>

    <script src="~/js/layout_DailyCare.js"></script>
    <script src="~/js/Dailycare.js"></script>
    <script>
        (function () {
            function useSharedAssistant() {
                window.confirmGoToChat = function () {
                    if (typeof window.closeChatConfirm === "function") window.closeChatConfirm();
                    if (window.parent && window.parent !== window) {
                        window.parent.postMessage({ type: "unified_ai_show_chat" }, window.location.origin);
                    } else if (typeof window.openAI === "function") {
                        window.openAI(true);
                    }
                };
            }
            useSharedAssistant();
            window.addEventListener("load", useSharedAssistant);
        })();
    </script>

</div>

<script>
    (function () {
        var wakeLock = null;
        var holding = false;

        function acquire() {
            if (!('wakeLock' in navigator) || wakeLock) return;
            navigator.wakeLock.request('screen').then(function (lock) {
                wakeLock = lock;
                lock.addEventListener('release', function () { wakeLock = null; });
            }).catch(function () { });
        }

        function release() {
            if (wakeLock) {
                try { wakeLock.release(); } catch (e) { }
                wakeLock = null;
            }
        }

        function evaluate() {
            var s = document.body.getAttribute('data-state');
            var want = (s === 'connecting' || s === 'connected');
            if (want && !holding) { holding = true; acquire(); }
            else if (!want && holding) { holding = false; release(); }
        }

        try {
            new MutationObserver(evaluate).observe(document.body, { attributes: true, attributeFilter: ['data-state'] });
        } catch (e) { }

        document.addEventListener('visibilitychange', function () {
            if (!document.hidden && holding) acquire();
        });

        window.addEventListener('pagehide', function () { holding = false; release(); });

        if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', evaluate, { once: true });
        } else {
            evaluate();
        }
    })();
</script>