    <script>
        function loadAndOpenStatusModal() {
            var bedId = encodeURIComponent(BedContext.taskBedId() || '');
            var bedNumber = encodeURIComponent(BedContext.taskBedNumber() || '');

            document.getElementById('rs-active-section-title').textContent = "LOADING...";
            document.getElementById('rs-active-container').innerHTML = '<p style="color:#64748b; font-size:14px;">Fetching status...</p>';
            document.getElementById('rs-completed-list').innerHTML = '';
