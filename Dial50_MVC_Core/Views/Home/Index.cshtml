@model BedInfo
@{
    ViewData["Title"] = ":: Chat AI ::";
    ViewData["UseCustomVoiceAgent"] = true;
}

<link rel="stylesheet" href="~/fontawesome/css/all.min.css" />

<link rel="stylesheet" href="~/css/DailyCare.css">
<link rel="stylesheet" href="~/css/voice-agent/styles.css" asp-append-version="true">
<link rel="stylesheet" href="~/css/unified-ai.css" asp-append-version="true">
<script src="~/js/voice-agent/config.js" asp-append-version="true"></script>

<style>

    body:not([data-state]) #callLayer,
    body:not([data-state]) #endedLayer,
    body:not([data-state]) .call-layer,
    body:not([data-state]) .ended-layer {
        display: none !important;
    }

    html[data-autostart="pending"] .app-wrapper > *:not(#autoStartLoader) {
        visibility: hidden !important;
        opacity: 0 !important;
    }

    #autoStartLoader {
        display: none;
        position: fixed;
        inset: 0;
        align-items: center;
        justify-content: center;
        flex-direction: column;
        gap: 16px;
        background: #f1f3f7;
        z-index: 100002;
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    }

    html[data-autostart="pending"] #autoStartLoader {
        display: flex !important;
    }

    #autoStartLoader .spinner {
        width: 44px;
        height: 44px;
        border-radius: 50%;
        border: 3px solid #e2e8f0;
        border-top-color: #6366f1;
        animation: autostartSpin 0.8s linear infinite;
    }

    #autoStartLoader .lbl {
        font-size: 15px;
        font-weight: 600;
        color: #475569;
    }

    @@keyframes autostartSpin {
        to {
            transform: rotate(360deg);
        }
    }

    html {
        width: 100% !important;
        min-width: 100% !important;
        margin: 0 !important;
        padding: 0 !important;
        background: #f1f3f7 !important;
    }

    body {
        width: 100% !important;
        min-width: 100% !important;
        margin: 0 !important;
        padding: 0 !important;
        background: #f1f3f7 !important;
        display: flex !important;
        flex-direction: row !important;
        justify-content: center !important;
        align-items: flex-start !important;
        min-height: 100vh !important;
    }

    .app-wrapper {
        position: relative !important;
        display: flex !important;
        flex-direction: column !important;
        width: 100% !important;
        max-width: 430px !important;
        min-width: 320px !important;
        margin-left: auto !important;
        margin-right: auto !important;
        margin-top: 0 !important;
        margin-bottom: 0 !important;
