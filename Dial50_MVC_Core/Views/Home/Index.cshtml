            border-radius: 20px;
            width: fit-content;
            border: 1px solid rgba(255,255,255,0.3);
            position: absolute;
            top: 12px;
            right: 12px;
        }

            .patfeedback-card .card-pill i {
                font-size: 8px;
                margin-right: 3px;
                color: #4d4a00 !important;
            }

        .patfeedback-card .card-link-row {
