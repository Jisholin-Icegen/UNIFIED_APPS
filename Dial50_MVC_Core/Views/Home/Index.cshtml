            fetch('/Home/GetTasks?BedId=' + bedId + '&BedNumber=' + bedNumber)
                .then(res => res.json())
                .then(data => {
                    if (!Array.isArray(data)) data = [];

                    let activeTasks = [];
                    let completedTasks = [];

                    data.forEach(t => {
                        let status = String(t.status || t.Status || "").toLowerCase().trim();
                        let isDone = ["completed", "delivered", "cancelled", "canceled"].includes(status);

                        if (isDone) completedTasks.push(t);
                        else activeTasks.push(t);
                    });

                    if (activeTasks.length > 0) {
                        document.getElementById('rs-active-section-title').textContent = `ACTIVE (${activeTasks.length})`;

                        let html = "";
                        activeTasks.forEach(task => {
                            let statusKey = String(task.status || task.Status || "").toLowerCase().trim();
                            let service = String(task.service || task.Service || "").toUpperCase().trim();
                            let isFood = service.includes("FOOD");

                            // Define steps based on Service Type
                            let steps = isFood
                                ? ["Placed", "Received", "Preparing", "Ready", "Delivering"]
                                : ["Pending", "Assigned", "In-Progress", "Completed"];

                            // Map status to step number
                            let currentStep = 1;
                            if (isFood) {
                                if (["accepted", "confirmed", "assigned"].includes(statusKey)) currentStep = 2;
                                if (["in-progress", "inprogress", "preparing", "assembling"].includes(statusKey)) currentStep = 3;
                                if (["ready", "ready-for-pickup", "readyforpickup"].includes(statusKey)) currentStep = 4;
                                if (["delivering", "out-for-delivery"].includes(statusKey)) currentStep = 5;
                            } else {
                                if (["assigned", "accepted", "ready"].includes(statusKey)) currentStep = 2;
                                if (["in-progress", "inprogress", "preparing", "assembling"].includes(statusKey)) currentStep = 3;
                                if (["completed", "delivered", "cancelled"].includes(statusKey)) currentStep = 4;
                            }

                            let trackerHtml = "";
                            for (let i = 0; i < steps.length; i++) {
                                let stepNum = i + 1;
                                let stepClass = "";
                                let lineClass = "";

                                if (stepNum < currentStep) { stepClass = "completed"; lineClass = "completed"; }
                                else if (stepNum === currentStep) { stepClass = "current"; }

                                let circleContent = stepNum < currentStep
                                    ? `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M20 6L9 17l-5-5"/></svg>`
                                    : stepNum;

                                trackerHtml += `
                                    <div class="rs-step ${stepClass}">
                                        <div class="rs-step-circle">${circleContent}</div>
                                        <span class="rs-step-label">${steps[i]}</span>
                                    </div>
                                `;
                                if (i < steps.length - 1) {
                                    trackerHtml += `<div class="rs-step-line ${lineClass}"></div>`;
                                }
                            }

                            html += `
                            <div class="rs-active-card">
                                <div class="rs-card-header">
                                    <span class="rs-card-title">${task.taskName || task.TaskName || 'Request'}</span>
                                    <span class="rs-status-badge">${statusKey.toUpperCase()}</span>
                                </div>
                                <div class="rs-progress-tracker">${trackerHtml}</div>
                                <div class="rs-card-details">
                                    <div class="rs-req-id">REQ-${task.taskId || task.TaskId}</div>
                                    <div class="rs-req-desc">${task.description || task.Description || task.remarks || 'Processing'}</div>
                                </div>
                            </div>`;
                        });

                        document.getElementById('rs-active-container').innerHTML = html;
                    } else {
                        document.getElementById('rs-active-section-title').textContent = "ACTIVE (0)";
                        document.getElementById('rs-active-container').innerHTML = '<p style="color:#64748b; font-size:14px; padding:10px 0;">No active requests right now.</p>';
                    }

                    if (completedTasks.length > 0) {
                        let completedHtml = "";
                        completedTasks.forEach(t => {
                            completedHtml += `
                            <div class="rs-completed-card">
                                <div class="rs-completed-info">
                                    <div class="rs-completed-name">${t.taskName || t.TaskName || 'Request'}</div>
                                    <div class="rs-completed-id">REQ-${t.taskId || t.TaskId}</div>
                                </div>
                                <div class="rs-completed-icon">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><polyline points="16 12 12 8 8 12"></polyline><line x1="12" y1="16" x2="12" y2="8"></line></svg>
                                </div>
                            </div>`;
                        });
                        document.getElementById('rs-completed-list').innerHTML = completedHtml;
                    } else {
                        document.getElementById('rs-completed-list').innerHTML = '<p style="color:#64748b; font-size:13px; padding:10px 0;">No completed requests yet.</p>';
                    }
                })
                .catch(err => {
                    console.error(err);
                    document.getElementById('rs-active-section-title').textContent = "ERROR";
                    document.getElementById('rs-active-container').innerHTML = '<p style="color:#ef4444; font-size:14px;">Failed to load tasks. Please try again.</p>';
                });
        }
    </script>
</div>

