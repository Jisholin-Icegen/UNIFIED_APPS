    .control-btn#micBtn,
    .control-btn.speaker-btn {
        position: relative !important;
        width: 56px !important;
        height: 56px !important;
        padding: 0 !important;
        margin: 0 !important;
        border: 1px solid rgba(255, 255, 255, 0.12) !important;
        border-radius: 50% !important;
        background: linear-gradient( 145deg, rgba(255, 255, 255, 0.10), rgba(255, 255, 255, 0.03) ) !important;
        box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.20), inset 0 -1px 0 rgba(255, 255, 255, 0.05), 0 2px 6px rgba(0, 0, 0, 0.3) !important;
        display: flex !important;
        align-items: center !important;
        justify-content: center !important;
        overflow: visible !important;
        cursor: pointer !important;
        box-sizing: border-box !important;
        transition: transform 0.1s ease, box-shadow 0.2s ease !important;
    }

        .control-btn#micBtn .control-icon,
        .control-btn.speaker-btn .control-icon {
            width: 24px !important;
            height: 24px !important;
            object-fit: contain !important;
            display: block !important;
            filter: brightness(0) invert(1) !important;
            opacity: 1 !important;
        }

        .control-btn#micBtn.muted::before,
        .control-btn.speaker-btn.muted::before {
            content: "" !important;
            position: absolute !important;
            inset: 0 !important;
            border-radius: 50% !important;
            background: radial-gradient( circle at center, rgba(39, 157, 148, 0.18), transparent 70% ) !important;
            pointer-events: none !important;
            z-index: 1 !important;
        }

        .control-btn#micBtn.muted::after,
        .control-btn.speaker-btn.muted::after {
            content: "" !important;
            position: absolute !important;
            width: 34px !important;
            height: 3px !important;
            background: linear-gradient( 90deg, rgba(39, 157, 148, 0) 0%, #279d94 15%, #2ee0d2 50%, #279d94 85%, rgba(39, 157, 148, 0) 100% ) !important;
            border-radius: 3px !important;
            transform: rotate(-45deg) !important;
            pointer-events: none !important;
            z-index: 3 !important;
            box-shadow: 0 0 6px rgba(46, 224, 210, 0.6), 0 0 12px rgba(39, 157, 148, 0.35) !important;
        }

        .control-btn#micBtn:active,
        .control-btn.speaker-btn:active {
            transform: scale(0.92) !important;
            box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.20), inset 0 -1px 0 rgba(255, 255, 255, 0.05), 0 3px 10px rgba(0, 0, 0, 0.40) !important;
        }

        .control-btn#micBtn:focus,
        .control-btn.speaker-btn:focus {
            outline: none !important;
        }

