    body:has(.video-overlay.show) #header,
    body:has(.video-overlay.show) .header,
    body:has(.video-overlay.show) .header-flex,
    body:has(.video-overlay.show) .header-nav,
    body:has(.video-overlay.show) .support-ico,
    body:has(.video-overlay.show) .support-icon,
    body:has(.video-overlay.show) .support-icons,
    body:has(.video-overlay.show) footer,
    body:has(.video-overlay.show) #footer,
    body:has(.video-overlay.show) .app-wrapper > footer,
    body:has(.video-overlay.show) #pageNav,
    body:has(.video-overlay.show) .nav,
    body:has(.video-overlay.show) .nav-bar,
    body:has(.video-overlay.show) .bottom-nav,
    body:has(.video-overlay.show) .top-nav,
    body:has(.video-overlay.show) .app-nav,
    body:has(.video-overlay.show) .assistant-titlebar,
