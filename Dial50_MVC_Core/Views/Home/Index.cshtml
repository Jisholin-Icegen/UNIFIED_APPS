        body:is([data-state="connecting"], [data-state="connected"], [data-state="ended"]):not([data-call-presentation="minimized"]) .patfeedback-card,
        body:is([data-state="connecting"], [data-state="connected"], [data-state="ended"]):not([data-call-presentation="minimized"]) .bottom-card,
